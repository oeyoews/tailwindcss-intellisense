{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行扩展",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-tiddlywiki"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-tiddlywiki/out/**/*.js"
      ]
    }
  ]
}