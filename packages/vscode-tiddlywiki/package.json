{
  "private": true,
  "keywords": [
    "TiddlyWiki",
    "Usewiki2"
  ],
  "author": {
    "name": "oeyoews"
  },
  "pricing": "Free",
  "funding": "https://github.com/sponsors/oeyoews",
  "homepage": "https://github.com/oeyoews/vscode-intellisense#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oeyoews/vscode-intellisense#readme"
  },
  "name": "vscode-tiddlywiki",
  "displayName": "TiddlyWiki Intellisense",
  "description": "为 TiddlyWiki 提供智能感知、补全、诊断等功能的 VSCode 扩展。",
  "version": "0.0.1",
  "publisher": "oeyoews",
  "engines": {
    "vscode": ">=1.80.0"
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tiddlywiki",
        "aliases": [
          "TiddlyWiki",
          "TiddlyWiki5",
          "tiddlywiki"
        ],
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        },
        "extensions": [
          ".tid",
          ".meta",
          ".tw5"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tiddlywiki",
        "scopeName": "source.tiddlywiki",
        "path": "./syntaxes/tiddlywiki.tmLanguage.json"
      }
    ],
    "files.associations": {
      "*.tid": "Tiddlywiki",
      "*.meta": "tiddlywiki",
      "*.tw5": "tiddlywiki"
    }
  },
  "devDependencies": {
    "@types/vscode": "1.80.0",
    "typescript": "^5.8.3"
  },
    "files": [
      "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/vsce": "3.2.0"
  }
}