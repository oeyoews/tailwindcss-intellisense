{
  "private": true,
  "keywords": [
    "TiddlyWiki"
  ],
  "author": {
    "name": "oeyoews"
  },
  "pricing": "Free",
  "funding": "https://github.com/sponsors/oeyoews",
  "homepage": "https://github.com/oeyoews/vscode-intellisense#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oeyoews/vscode-intellisense#readme"
  },
  "name": "vscode-tiddlywiki",
  "displayName": "TiddlyWiki Intellisense",
  "description": "为 TiddlyWiki 提供智能感知、补全、诊断等功能的 VSCode 扩展。",
  "version": "0.0.1",
  "publisher": "oeyoews",
  "engines": {
    "vscode": ">=1.80.0"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "vsce package"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "media/logo.png",
  "main": "dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tiddlywiki",
        "aliases": [
          "TiddlyWiki",
          "tiddlywiki"
        ],
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        },
        "extensions": [
          ".tid",
          ".meta"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "json",
        "extensions": [
          ".info",
          ".files"
        ],
        "aliases": [
          "Tiddlywiki5 Json",
          "tiddlywiki5-json"
        ]
      }
    ],
    "grammars": [
      {
        "language": "tiddlywiki",
        "scopeName": "source.tiddlywiki",
        "path": "./syntaxes/tiddlywiki.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "3.4.0",
    "esbuild": "^0.25.4",
    "tiddlywiki-language-server": "workspace:*",
    "typescript": "^5.8.3"
  },
  "configurationDefaults": {
    "files.associations": {
      "*.tid": "tiddlywiki",
      "*.meta": "tiddlywiki"
    }
  },
  "files": [
    "dist",
    "syntaxes",
    "media",
    "language-configuration.json",
    "LICENSE"
  ],
  "license": "MIT"
}